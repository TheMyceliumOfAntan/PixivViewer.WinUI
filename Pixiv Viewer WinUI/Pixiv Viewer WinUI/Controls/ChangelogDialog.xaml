<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Pixiv_Viewer_WinUI.Controls.ChangelogDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Pixiv_Viewer_WinUI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Pixiv_Viewer_WinUI.Models"
    Title="更新日志"
    CloseButtonText="关闭"
    DefaultButton="Close"
    mc:Ignorable="d">

    <ScrollViewer
        MaxHeight="520"
        MinWidth="480"
        Padding="0,0,8,0"
        VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="EntriesHost">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ChangelogEntry">
                    <StackPanel>
                        <!--  版本号：加粗加大，与下面的内容用间距隔开  -->
                        <StackPanel
                            Margin="0,0,0,10"
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                FontSize="20"
                                FontWeight="Bold"
                                Text="{x:Bind Version}"
                                TextWrapping="NoWrap" />
                            <Border
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="6"
                                Visibility="{x:Bind IsLatest, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="当前版本" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Bottom"
                                Style="{StaticResource MetaTextBlockStyle}"
                                Text="{x:Bind Date}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid Margin="0,0,0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="•" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="13"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  版本之间用分割线隔开  -->
                        <Rectangle
                            Margin="0,10,0,16"
                            Style="{StaticResource DividerRectangleStyle}"
                            Visibility="{x:Bind ShowDivider, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</ContentDialog>
