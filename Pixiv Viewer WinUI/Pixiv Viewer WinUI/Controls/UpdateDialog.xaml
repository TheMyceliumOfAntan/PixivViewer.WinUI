<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Pixiv_Viewer_WinUI.Controls.UpdateDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="发现新版本"
    CloseButtonClick="OnCloseButtonClick"
    CloseButtonText="稍后"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="下载并安装"
    SecondaryButtonClick="OnSecondaryButtonClick"
    SecondaryButtonText="跳过此版本"
    mc:Ignorable="d">

    <StackPanel MinWidth="440" Spacing="12">
        <StackPanel Spacing="2">
            <TextBlock
                x:Name="VersionText"
                FontSize="18"
                FontWeight="SemiBold"
                Text="Pixiv Viewer 1.1.1" />
            <TextBlock
                x:Name="MetaText"
                Style="{StaticResource MetaTextBlockStyle}"
                Text="当前版本 1.1.0" />
        </StackPanel>

        <Border
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <ScrollViewer
                MaxHeight="260"
                VerticalScrollBarVisibility="Auto">
                <TextBlock
                    x:Name="NotesText"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <StackPanel
            x:Name="ProgressPanel"
            Spacing="6"
            Visibility="Collapsed">
            <TextBlock x:Name="ProgressText" Style="{StaticResource MetaTextBlockStyle}" />
            <ProgressBar
                x:Name="ProgressBar"
                Maximum="100"
                Minimum="0" />
        </StackPanel>

        <TextBlock
            x:Name="ErrorText"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
