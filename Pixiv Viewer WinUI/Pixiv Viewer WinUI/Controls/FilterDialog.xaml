<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Pixiv_Viewer_WinUI.Controls.FilterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixiv_Viewer_WinUI.Controls"
    xmlns:models="using:Pixiv_Viewer_WinUI.Models"
    Title="筛选"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="OnApplyClick"
    PrimaryButtonText="应用">

    <StackPanel MinWidth="420" Spacing="14">

        <!--  标签  -->
        <StackPanel Spacing="6">
            <TextBlock Style="{StaticResource SectionHeaderTextBlockStyle}" Text="标签（同时包含，可多选）" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox
                    x:Name="TagInput"
                    PlaceholderText="输入标签，可输入中文或英文"
                    QueryIcon="Add"
                    QuerySubmitted="OnTagQuerySubmitted"
                    TextChanged="OnTagTextChanged">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="models:TagSuggestion">
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="14" Text="{x:Bind Tag}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind TranslationText}"
                                    Visibility="{x:Bind HasTranslationText, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <Button
                    Grid.Column="1"
                    Click="OnAddTagClick"
                    Content="添加" />
            </Grid>
            <ItemsRepeater x:Name="TagChips">
                <ItemsRepeater.Layout>
                    <controls:WrapLayout Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button
                            Click="OnRemoveTagClick"
                            Style="{StaticResource TagChipButtonStyle}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="点击移除">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock FontSize="12" Text="{x:Bind}" />
                                <FontIcon FontSize="10" Glyph="&#xE711;" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>

        <Rectangle Style="{StaticResource DividerRectangleStyle}" />

        <!--  作品类别（推荐页用）  -->
        <StackPanel
            x:Name="CategoryPanel"
            Spacing="6"
            Visibility="Collapsed">
            <TextBlock Style="{StaticResource SectionHeaderTextBlockStyle}" Text="作品类别" />
            <ComboBox
                x:Name="CategoryBox"
                MinWidth="160">
                <ComboBoxItem Content="全部" Tag="All" IsSelected="True" />
                <ComboBoxItem Content="插画" Tag="Illustrations" />
                <ComboBoxItem Content="漫画" Tag="Manga" />
                <ComboBoxItem Content="动图" Tag="Ugoira" />
            </ComboBox>
        </StackPanel>

        <!--  内容开关  -->
        <StackPanel Spacing="2">
            <ToggleSwitch
                x:Name="AiSwitch"
                Header="显示 AI 作品"
                OffContent="隐藏"
                OnContent="显示" />
            <ToggleSwitch
                x:Name="R18Switch"
                Header="显示 R-18 作品"
                OffContent="隐藏"
                OnContent="显示" />
            <ToggleSwitch
                x:Name="R18GSwitch"
                Header="显示 R-18G 作品"
                OffContent="隐藏"
                OnContent="显示" />
            <TextBlock
                x:Name="AdultHint"
                Style="{StaticResource MetaTextBlockStyle}"
                Text="R-18 / R-18G 总开关在「设置」里，关闭时这里的开关不可用。"
                TextWrapping="Wrap" />
        </StackPanel>

        <Rectangle Style="{StaticResource DividerRectangleStyle}" />

        <!--  黑名单  -->
        <StackPanel Spacing="6">
            <TextBlock Style="{StaticResource SectionHeaderTextBlockStyle}" Text="黑名单标签" />
            <TextBox
                x:Name="BlockedBox"
                PlaceholderText="逗号或空格分隔，例如：グロ, AI生成" />

            <!--  黑名单标签候选：选中后追加到上面的输入框  -->
            <AutoSuggestBox
                x:Name="BlockedTagInput"
                Margin="0,4,0,0"
                PlaceholderText="也可以在这里输入中文/英文补全后添加"
                QueryIcon="Add"
                QuerySubmitted="OnBlockedTagQuerySubmitted"
                TextChanged="OnBlockedTagTextChanged">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TagSuggestion">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="14" Text="{x:Bind Tag}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind TranslationText}"
                                Visibility="{x:Bind HasTranslationText, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
        </StackPanel>
    </StackPanel>
</ContentDialog>
