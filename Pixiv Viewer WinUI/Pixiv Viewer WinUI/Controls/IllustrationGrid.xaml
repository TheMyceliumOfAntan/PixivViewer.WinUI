<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Pixiv_Viewer_WinUI.Controls.IllustrationGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Pixiv_Viewer_WinUI.Controls"
    xmlns:models="using:Pixiv_Viewer_WinUI.Models"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer
            x:Name="Scroller"
            Padding="0,0,4,24"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled"
            ViewChanged="OnScrollerViewChanged">

            <ItemsRepeater
                x:Name="Repeater"
                HorizontalAlignment="Left"
                ItemsSource="{x:Bind ItemsSource, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <controls:MasonryLayout
                        MaxColumns="6"
                        MinItemWidth="200"
                        Spacing="12" />
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:Illustration">
                        <Button
                            Tag="{x:Bind}"
                            Style="{StaticResource IllustrationCardButtonStyle}"
                            Click="OnCardClick"
                            PointerEntered="OnCardPointerEntered"
                            PointerExited="OnCardPointerExited"
                            ToolTipService.ToolTip="{x:Bind Title}">

                            <Button.ContextFlyout>
                                <MenuFlyout Opening="OnMenuOpening">
                                    <MenuFlyoutItem
                                        x:Name="BookmarkMenuItem"
                                        Click="OnMenuBookmark"
                                        Tag="{x:Bind}"
                                        Text="收藏">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE734;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Name="PrivateBookmarkMenuItem"
                                        Click="OnMenuLike"
                                        Tag="{x:Bind}"
                                        Text="私密收藏">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE72E;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        Click="OnMenuDownload"
                                        Tag="{x:Bind}"
                                        Text="下载">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE896;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.ContextFlyout>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  卡片底板：始终可见的圆角，把图片和文字一起框住  -->
                                <Border
                                    Grid.RowSpan="2"
                                    Background="{ThemeResource GalleryCardFillBrush}"
                                    BorderBrush="{ThemeResource GalleryCardStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12" />

                                <!--  封面：上圆角、下直角（直角边与文字区区分）  -->
                                <Border
                                    Grid.Row="0"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="11,11,0,0">
                                    <controls:AspectRatioPanel AspectRatio="{x:Bind AspectRatio}">
                                        <!--  骨架：图片加载完成前显示  -->
                                        <Rectangle Fill="{ThemeResource SkeletonFillBrush}" />

                                        <Image
                                            controls:CachedImage.DecodeWidth="300"
                                            controls:CachedImage.Url="{x:Bind ThumbnailUrl}"
                                            Opacity="0"
                                            Stretch="UniformToFill">
                                            <Image.OpacityTransition>
                                                <ScalarTransition Duration="0:0:0.22" />
                                            </Image.OpacityTransition>
                                        </Image>

                                        <!--  左上角：排名 + 分级标注  -->
                                        <StackPanel
                                            Margin="8"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <Border
                                                Padding="6,1"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="6"
                                                Visibility="{x:Bind Rank, Converter={StaticResource PositiveIntToVisibility}}">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Text="{x:Bind RankText}" />
                                            </Border>

                                            <Border
                                                Padding="6,1"
                                                Background="#E6C42B1C"
                                                CornerRadius="6"
                                                Visibility="{x:Bind HasRating, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="{x:Bind RatingText}" />
                                            </Border>
                                        </StackPanel>

                                        <!--  右上角：页数  -->
                                        <Border
                                            Margin="8"
                                            Padding="6,2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#8C000000"
                                            CornerRadius="8"
                                            Visibility="{x:Bind PageText, Converter={StaticResource StringToVisibility}}">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="White"
                                                Text="{x:Bind PageText}" />
                                        </Border>

                                        <!--  右下角：已收藏标记  -->
                                        <Border
                                            Margin="8"
                                            Padding="5,3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Background="#8C000000"
                                            CornerRadius="8"
                                            Visibility="{x:Bind IsBookmarked, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <FontIcon
                                                FontSize="12"
                                                Foreground="#FFD84A"
                                                Glyph="&#xE735;" />
                                        </Border>
                                    </controls:AspectRatioPanel>
                                </Border>

                                <!--  文字区（在卡片内部）  -->
                                <StackPanel
                                    Grid.Row="1"
                                    Padding="12,8,12,11"
                                    Spacing="4">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        MaxLines="2"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Author.Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="3">
                                            <FontIcon
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xEB51;" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind LikeText}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!--  操作反馈（实色背景，避免被图片透视）  -->
        <Border
            x:Name="Toast"
            Margin="0,0,0,24"
            Padding="12,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Translation="0,0,16"
            Visibility="Collapsed">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <TextBlock
                x:Name="ToastText"
                MaxWidth="520"
                FontSize="13"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
