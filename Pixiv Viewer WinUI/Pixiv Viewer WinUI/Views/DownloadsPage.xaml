<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pixiv_Viewer_WinUI.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Pixiv_Viewer_WinUI.Models"
    xmlns:controls="using:Pixiv_Viewer_WinUI.Controls"
    Background="Transparent">

    <Grid Padding="28,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  页头  -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" Text="下载" />
                <TextBlock
                    x:Name="Subtitle"
                    Style="{StaticResource PageSubtitleTextBlockStyle}"
                    Text="查看与管理下载任务" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button Click="OnPauseAllClick" ToolTipService.ToolTip="全部暂停">
                    <FontIcon FontSize="14" Glyph="&#xE769;" />
                </Button>
                <Button Click="OnResumeAllClick" ToolTipService.ToolTip="全部继续">
                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                </Button>
                <Button Click="OnClearCompletedClick" ToolTipService.ToolTip="清空已完成">
                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                </Button>
                <Button Click="OnOpenFolderClick" ToolTipService.ToolTip="打开下载文件夹">
                    <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  总进度  -->
        <Border
            Grid.Row="1"
            Padding="16,12"
            Style="{StaticResource SurfaceCardStyle}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock
                        x:Name="SummaryText"
                        Style="{StaticResource SectionHeaderTextBlockStyle}"
                        Text="暂无任务" />
                    <TextBlock
                        x:Name="FolderText"
                        HorizontalAlignment="Right"
                        Style="{StaticResource MetaTextBlockStyle}"
                        Text="保存到 D:\Pixiv" />
                </Grid>

                <ProgressBar
                    x:Name="OverallBar"
                    Grid.Row="1"
                    Height="4"
                    Maximum="100"
                    Value="0" />
            </Grid>
        </Border>

        <SelectorBar
            x:Name="FilterSelector"
            Grid.Row="2"
            SelectionChanged="OnFilterChanged">
            <SelectorBarItem
                IsSelected="True"
                Tag="all"
                Text="全部" />
            <SelectorBarItem Tag="active" Text="进行中" />
            <SelectorBarItem Tag="completed" Text="已完成" />
            <SelectorBarItem Tag="failed" Text="失败" />
        </SelectorBar>

        <!--  任务列表  -->
        <Grid Grid.Row="3">
            <ListView
                x:Name="TaskList"
                Padding="0,0,0,24"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadTask">
                        <Border
                            Padding="14,10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="56"
                                    Height="56"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <Grid>
                                        <Rectangle Fill="{ThemeResource SkeletonFillBrush}" />
                                        <Image
                                            controls:CachedImage.DecodeWidth="96"
                                            controls:CachedImage.Url="{x:Bind ThumbnailUrl}"
                                            Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="6">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis" />

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar
                                            Height="4"
                                            VerticalAlignment="Center"
                                            Maximum="100"
                                            Value="{x:Bind Progress, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource MetaTextBlockStyle}"
                                            Text="{x:Bind ProgressText, Mode=OneWay}" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Style="{StaticResource MetaTextBlockStyle}" Text="{x:Bind StateText, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource MetaTextBlockStyle}" Text="{x:Bind SizeText, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource MetaTextBlockStyle}" Text="{x:Bind SpeedText, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource MetaTextBlockStyle}" Text="{x:Bind PageText}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        Click="OnPauseClick"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="暂停"
                                        Visibility="{x:Bind CanPause, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <FontIcon FontSize="14" Glyph="&#xE769;" />
                                    </Button>
                                    <Button
                                        Click="OnResumeClick"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="继续"
                                        Visibility="{x:Bind CanResume, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                                    </Button>
                                    <Button
                                        Click="OnRetryClick"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="重试"
                                        Visibility="{x:Bind CanRetry, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                    </Button>
                                    <Button
                                        Click="OnOpenClick"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="打开文件"
                                        Visibility="{x:Bind CanOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                                    </Button>
                                    <Button
                                        Click="OnDeleteClick"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="删除（含已下载文件）">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                    <Button
                                        Click="OnCancelClick"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="取消"
                                        Visibility="{x:Bind CanCancel, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE896;" />
                <TextBlock
                    x:Name="EmptyTitle"
                    Style="{StaticResource EmptyStateTitleStyle}"
                    Text="还没有下载任务" />
                <TextBlock
                    x:Name="EmptyMessage"
                    Style="{StaticResource EmptyStateMessageStyle}"
                    Text="在作品详情页点击「下载」，任务会出现在这里，可随时暂停或继续。" />
            </StackPanel>

            <ProgressRing
                x:Name="LoadingRing"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
