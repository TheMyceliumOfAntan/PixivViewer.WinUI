<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pixiv_Viewer_WinUI.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixiv_Viewer_WinUI.Controls"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="28,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  页头  -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" Text="推荐" />
                <TextBlock
                    x:Name="Subtitle"
                    Style="{StaticResource PageSubtitleTextBlockStyle}"
                    Text="正在加载…" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="OnFilterClick" ToolTipService.ToolTip="筛选（标签 / AI / R-18）">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE71C;" />
                        <TextBlock Text="筛选" />
                    </StackPanel>
                </Button>
                <Button Click="OnRefreshClick" ToolTipService.ToolTip="刷新">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="SampleBar"
            Grid.Row="1"
            IsOpen="True"
            Severity="Informational"
            Title="当前显示示例数据"
            Message="接口不可用，内容为设计预览用假数据，可在「设置 → 使用示例数据」中关闭。" />

        <!--  已启用的筛选（默认隐藏，点「筛选」配置）  -->
        <StackPanel
            x:Name="FilterBar"
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed">
            <ItemsRepeater x:Name="TagChips">
                <ItemsRepeater.Layout>
                    <controls:WrapLayout Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button
                            Click="OnRemoveTagClick"
                            Style="{StaticResource TagChipButtonStyle}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="点击移除">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock FontSize="12" Text="{x:Bind}" />
                                <FontIcon FontSize="10" Glyph="&#xE711;" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <Button
                Click="OnClearFilterClick"
                Content="清除筛选"
                Style="{StaticResource TagChipButtonStyle}" />
        </StackPanel>

        <!--  内容  -->
        <Grid Grid.Row="3">
            <controls:IllustrationGrid
                x:Name="Illustrations"
                CardActionRequested="OnCardAction"
                ItemInvoked="OnItemInvoked" />

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="Collapsed">
                <FontIcon
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xEB9F;" />
                <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="暂无推荐作品" />
                <TextBlock
                    x:Name="EmptyMessage"
                    Style="{StaticResource EmptyStateMessageStyle}"
                    Text="换个筛选条件，或稍后刷新再试。" />
                <Button
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Click="OnRefreshClick"
                    Content="重新加载" />
            </StackPanel>

            <ProgressRing
                x:Name="LoadingRing"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="False" />
        </Grid>
    </Grid>
</Page>
