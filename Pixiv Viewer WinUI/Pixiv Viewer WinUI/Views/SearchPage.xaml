<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pixiv_Viewer_WinUI.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixiv_Viewer_WinUI.Controls"
    xmlns:models="using:Pixiv_Viewer_WinUI.Models"
    NavigationCacheMode="Required"
    Background="Transparent">

    <Grid Padding="28,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Style="{StaticResource PageTitleTextBlockStyle}" Text="搜索" />
            <TextBlock
                x:Name="Subtitle"
                Style="{StaticResource PageSubtitleTextBlockStyle}"
                Text="输入标签后回车加入筛选（可多选，同时包含）" />
        </StackPanel>

        <!--  搜索栏  -->
        <Grid
            Grid.Row="1"
            MaxWidth="1100"
            HorizontalAlignment="Stretch"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                MinWidth="260"
                PlaceholderText="搜索标签，可输入中文或英文"
                QueryIcon="Find"
                QuerySubmitted="OnQuerySubmitted"
                TextChanged="OnQueryTextChanged">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TagSuggestion">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="14" Text="{x:Bind Tag}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind TranslationText}"
                                Visibility="{x:Bind HasTranslationText, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>

            <Button
                Grid.Column="1"
                Click="OnFilterClick"
                ToolTipService.ToolTip="筛选（标签 / AI / R-18 / 黑名单）">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE71C;" />
                    <TextBlock Text="筛选" />
                </StackPanel>
            </Button>

            <ComboBox
                x:Name="SortBox"
                Grid.Column="2"
                MinWidth="112"
                SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="按人气" Tag="Popular" IsSelected="True" />
                <ComboBoxItem Content="按最新" Tag="Latest" />
            </ComboBox>

            <ComboBox
                x:Name="TargetBox"
                Grid.Column="3"
                MinWidth="104"
                SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="全部" Tag="All" IsSelected="True" />
                <ComboBoxItem Content="插画" Tag="Illustrations" />
                <ComboBoxItem Content="漫画" Tag="Manga" />
                <ComboBoxItem Content="动图" Tag="Ugoira" />
            </ComboBox>
        </Grid>

        <!--  已选标签  -->
        <StackPanel
            x:Name="TagPanel"
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed">
            <ItemsRepeater x:Name="TagChips">
                <ItemsRepeater.Layout>
                    <controls:WrapLayout Spacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button
                            Click="OnRemoveTagClick"
                            Style="{StaticResource TagChipButtonStyle}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="点击移除">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock FontSize="12" Text="{x:Bind}" />
                                <FontIcon FontSize="10" Glyph="&#xE711;" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <Button
                Click="OnClearTagsClick"
                Content="清空"
                Style="{StaticResource TagChipButtonStyle}" />
        </StackPanel>

        <!--  热门标签  -->
        <StackPanel
            x:Name="SuggestionPanel"
            Grid.Row="3"
            Spacing="6">
            <TextBlock Style="{StaticResource SectionHeaderTextBlockStyle}" Text="热门标签" />
            <ListView
                x:Name="SuggestionList"
                Height="40"
                Padding="0"
                IsItemClickEnabled="True"
                ItemClick="OnSuggestionClick"
                SelectionMode="None"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border
                            Margin="0"
                            Padding="12,6"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="12">
                            <TextBlock FontSize="12" Text="{x:Bind}" />
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!--  结果  -->
        <Grid Grid.Row="4">
            <controls:IllustrationGrid
                x:Name="Illustrations"
                CardActionRequested="OnCardAction"
                ItemInvoked="OnItemInvoked"
                LoadMoreRequested="OnLoadMoreRequested" />

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
                <FontIcon
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE721;" />
                <TextBlock
                    x:Name="EmptyTitle"
                    Style="{StaticResource EmptyStateTitleStyle}"
                    Text="开始搜索" />
                <TextBlock
                    x:Name="EmptyMessage"
                    Style="{StaticResource EmptyStateMessageStyle}"
                    Text="输入标签后回车，可以叠加多个标签做 AND 搜索；黑名单标签在「筛选」里配置。" />
            </StackPanel>

            <ProgressRing
                x:Name="LoadingRing"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="False" />
        </Grid>
    </Grid>
</Page>
