<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pixiv_Viewer_WinUI.Views.TagPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixiv_Viewer_WinUI.Controls"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  工具栏  -->
        <Border
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid
                Height="52"
                Padding="8,0,12,0"
                ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Click="OnBackClick"
                    Style="{StaticResource ToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="返回 (Esc)">
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>

                <TextBlock
                    x:Name="TagTitle"
                    Grid.Column="1"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="#" />
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Padding="28,16,24,0"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  标题 + 统计  -->
            <StackPanel
                x:Name="HeaderPanel"
                RenderTransformOrigin="0.5,0"
                Grid.Row="0"
                Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock
                        x:Name="Heading"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Text="#" />
                    <TextBlock
                        x:Name="HeadingTranslation"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,5"
                        FontSize="18"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text=""
                        TextTrimming="CharacterEllipsis"
                        Visibility="Collapsed" />
                </StackPanel>
                <TextBlock
                    x:Name="Subtitle"
                    Style="{StaticResource PageSubtitleTextBlockStyle}"
                    Text="正在加载…" />
            </StackPanel>

            <!--  排序 / 类型 / 筛选  -->
            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                Spacing="8">
                <ComboBox
                    x:Name="SortBox"
                    MinWidth="120"
                    SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="按人气" Tag="Popular" IsSelected="True" />
                    <ComboBoxItem Content="按最新" Tag="Latest" />
                </ComboBox>
                <ComboBox
                    x:Name="TargetBox"
                    MinWidth="112"
                    SelectionChanged="OnFilterChanged">
                    <ComboBoxItem Content="全部" Tag="All" IsSelected="True" />
                    <ComboBoxItem Content="插画" Tag="Illustrations" />
                    <ComboBoxItem Content="漫画" Tag="Manga" />
                    <ComboBoxItem Content="动图" Tag="Ugoira" />
                </ComboBox>
                <Button Click="OnFilterClick" ToolTipService.ToolTip="筛选（AI / R-18 / 黑名单）">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE71C;" />
                        <TextBlock Text="筛选" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Grid Grid.Row="2">
                <controls:IllustrationGrid
                    x:Name="Illustrations"
                    CardActionRequested="OnCardAction"
                    ItemInvoked="OnItemInvoked"
                    LoadMoreRequested="OnLoadMoreRequested" />

                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="Collapsed">
                    <FontIcon
                        FontSize="36"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE8EC;" />
                    <TextBlock Style="{StaticResource EmptyStateTitleStyle}" Text="这个标签下没有作品" />
                    <TextBlock
                        Style="{StaticResource EmptyStateMessageStyle}"
                        Text="换个排序/类别，或检查「筛选」里的黑名单与 R-18 设置。" />
                </StackPanel>

                <ProgressRing
                    x:Name="LoadingRing"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False" />
            </Grid>
        </Grid>
    </Grid>
</Page>
