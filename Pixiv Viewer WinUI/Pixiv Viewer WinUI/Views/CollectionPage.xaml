<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Pixiv_Viewer_WinUI.Views.CollectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Pixiv_Viewer_WinUI.Controls"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  工具栏  -->
        <Border
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid
                Height="52"
                Padding="8,0,12,0"
                ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Click="OnBackClick"
                    Style="{StaticResource ToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="返回 (Esc)">
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>

                <TextBlock
                    Grid.Column="1"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="收藏集" />

                <Button
                    Grid.Column="2"
                    Click="OnOpenInBrowserClick"
                    Style="{StaticResource ToolbarIconButtonStyle}"
                    ToolTipService.ToolTip="在浏览器打开">
                    <FontIcon FontSize="14" Glyph="&#xE774;" />
                </Button>
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Padding="28,16,24,0"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  收藏集信息  -->
            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock
                    x:Name="Heading"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="收藏集"
                    TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PersonPicture
                        x:Name="AuthorAvatar"
                        Width="28"
                        Height="28"
                        DisplayName="?" />
                    <TextBlock
                        x:Name="AuthorName"
                        VerticalAlignment="Center"
                        FontSize="13" />
                    <TextBlock
                        x:Name="WorksText"
                        VerticalAlignment="Center"
                        Style="{StaticResource MetaTextBlockStyle}" />
                </StackPanel>

                <TextBlock
                    x:Name="Description"
                    MaxLines="3"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1">
                <controls:IllustrationGrid
                    x:Name="Illustrations"
                    CardActionRequested="OnCardAction"
                    ItemInvoked="OnItemInvoked" />

                <StackPanel
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="Collapsed">
                    <FontIcon
                        FontSize="36"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE8FD;" />
                    <TextBlock
                        x:Name="EmptyTitle"
                        Style="{StaticResource EmptyStateTitleStyle}"
                        Text="无法加载收藏集" />
                    <TextBlock
                        x:Name="EmptyMessage"
                        Style="{StaticResource EmptyStateMessageStyle}"
                        Text="收藏集需要网页登录：请到「设置 → 账号」点「网页登录」。" />
                    <Button
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Click="OnRetryClick"
                        Content="重试" />
                </StackPanel>

                <ProgressRing
                    x:Name="LoadingRing"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False" />
            </Grid>
        </Grid>
    </Grid>
</Page>
