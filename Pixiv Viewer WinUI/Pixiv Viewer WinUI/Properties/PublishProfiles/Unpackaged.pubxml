<?xml version="1.0" encoding="utf-8"?>
<!--
  非打包发布（免 MSIX、免安装、免签名）：
    dotnet publish "Pixiv Viewer WinUI\Pixiv Viewer WinUI\Pixiv Viewer WinUI.csproj" -p:PublishProfile=Unpackaged
  输出：D:\CSharp\Release\PixivViewer-win-x64\
  整个文件夹拷走即可双击 exe 运行，不需要安装 Windows App SDK 运行时，也不需要 .NET 运行时。
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishDir>D:\CSharp\Release\PixivViewer-win-x64\</PublishDir>
  </PropertyGroup>
</Project>
